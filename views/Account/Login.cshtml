@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - Bóveda Segura";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .login-card { max-width: 420px; width: 100%; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">

    <div class="card login-card shadow-lg border-0 rounded-4">
        <div class="card-body p-4 p-sm-5">

            <div class="text-center mb-4">
                <div class="display-4 mb-2">🔐</div>
                <h3 class="fw-bold text-dark">Bóveda Segura</h3>
                <p class="text-muted small">Ingresa tus credenciales para acceder</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 small mb-3 text-center" role="alert">
                    ✅ @TempData["Success"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small mb-3 text-center" role="alert">
                    ⚠️ @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">

                <div class="mb-3 text-start">
                    <label for="email" class="form-label fw-semibold text-secondary small">Correo Electrónico:</label>
                    <input type="email" id="email" name="email" class="form-control form-control-lg fs-6" autocomplete="off" required placeholder="nombre@ejemplo.com" value="" />
                </div>

                <div class="mb-3 text-start">
                    <label for="password" class="form-label fw-semibold text-secondary small">Contraseña:</label>
                    <div class="input-group">
                        <input type="password" id="password" name="password" class="form-control form-control-lg fs-6" autocomplete="new-password" required placeholder="••••••••" value="" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password', 'eyeIcon')">
                            <span id="eyeIcon">👁️</span>
                        </button>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4 mb-3">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold fs-6 py-2 shadow-sm">
                        Ingresar
                    </button>
                </div>

                <div class="text-center mt-3">
                    <small class="text-muted">¿No tienes una cuenta? <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Regístrate aquí</a></small>
                </div>

            </form>

        </div>
    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.textContent = "🙈";
            } else {
                input.type = "password";
                icon.textContent = "👁️";
            }
        }
    </script>

</body>
</html>