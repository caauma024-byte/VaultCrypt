@{
    Layout = null;
    ViewData["Title"] = "Crear Cuenta - Bóveda Segura";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .register-card { max-width: 450px; width: 100%; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 py-4">

    <div class="card register-card shadow-lg border-0 rounded-4">
        <div class="card-body p-4 p-sm-5">

            <div class="text-center mb-4">
                <div class="display-4 mb-2">🛡️</div>
                <h3 class="fw-bold text-dark">Crear cuenta</h3>
                <p class="text-muted small">Crea tu bóveda segura</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small mb-3 text-center" role="alert">
                    ⚠️ @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Register" method="post" autocomplete="off">

                <div class="mb-3 text-start">
                    <label for="fullName" class="form-label fw-semibold text-secondary small">Nombre:</label>
                    <input type="text" id="fullName" name="fullName" class="form-control form-control-lg fs-6" placeholder="Tu nombre" autocomplete="off" value="" />
                </div>

                <div class="mb-3 text-start">
                    <label for="email" class="form-label fw-semibold text-secondary small">Correo electrónico:</label>
                    <input type="email" id="email" name="email" class="form-control form-control-lg fs-6" required placeholder="correo@ejemplo.com" autocomplete="off" value="" />
                </div>

                <div class="mb-3 text-start">
                    <label for="password" class="form-label fw-semibold text-secondary small">Contraseña:</label>
                    <div class="input-group">
                        <input type="password" id="password" name="password" class="form-control form-control-lg fs-6" required placeholder="••••••••" autocomplete="new-password" value="" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password', 'eyeIcon1')">
                            <span id="eyeIcon1">👁️</span>
                        </button>
                    </div>
                </div>

                <div class="mb-3 text-start">
                    <label for="confirmPassword" class="form-label fw-semibold text-secondary small">Confirmar contraseña:</label>
                    <div class="input-group">
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control form-control-lg fs-6" required placeholder="••••••••" autocomplete="new-password" value="" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword', 'eyeIcon2')">
                            <span id="eyeIcon2">👁️</span>
                        </button>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4 mb-3">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold fs-6 py-2 shadow-sm">
                        🛡️ Crear cuenta
                    </button>
                </div>

                <div class="text-center mt-3">
                    <small class="text-muted">¿Ya tienes una cuenta? <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold">Iniciar sesión</a></small>
                </div>

            </form>

        </div>
    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.textContent = "🙈";
            } else {
                input.type = "password";
                icon.textContent = "👁️";
            }
        }
    </script>

</body>
</html>