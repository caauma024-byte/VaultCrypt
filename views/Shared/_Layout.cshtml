<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bóveda de Archivos</title>
    
    <!-- Bootstrap 5 CSS para un diseño limpio y moderno -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Encabezado / Navbar -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Account" asp-action="Login">
                    🔐 Bóveda de Archivos
                </a>
            </div>
        </nav>
    </header>

    <!-- Contenido Principal -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Pie de página limpio sin Privacy -->
    <footer class="footer border-top text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; @DateTime.Now.Year - Bóveda de Archivos - Sistema de Cifrado de Documentos</small>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>